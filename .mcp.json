{
  "mcpServers": {
    "alpaca": {
      "type": "stdio",
      "command": "uvx",
      "args": ["alpaca-mcp-server"],
      "env": {
        "ALPACA_API_KEY": "${ALPACA_API_KEY}",
        "ALPACA_SECRET_KEY": "${ALPACA_SECRET_KEY}",
        "ALPACA_PAPER": "true",
        "PYTHONUTF8":"1"
      }
    },
    "magpie": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "magpie-mcp"]
    }
  }
}
